
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# bd-auto
# Claude Code's own agent worktrees, created under the repo root; without this
# they show up as untracked files in the main checkout. bd-auto's worker
# worktrees live under .beads/auto/, covered below.
.claude/worktrees/
# Build artifact. Built with `make build`; put bin/ on your PATH.
/bin/bd-auto
# Run state and worker worktrees. Per-machine, and deliberately not shared.
.beads/auto/

# Python bytecode from the report scripts.
__pycache__/
